# ---------------------------------------------------------------------------
# Frontend (Vite). Copy to .env.local for development, and set the same
# variables in Vercel/Netlify -> Project -> Environment Variables.
# Leave VITE_SUPABASE_* empty to run in Demo mode (sample data, no backend).
# These are PUBLIC values (they end up in the browser bundle). Never put a
# secret key here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_META_APP_ID=your-meta-app-id

# Optional
# Show the "Pay with Paymob" button only once your Paymob account is approved.
VITE_PAYMOB_ENABLED=false
# Shown on /app/billing for manual payments during the beta.
VITE_MANUAL_INSTAPAY=yourname@instapay
VITE_MANUAL_WALLET=010XXXXXXXX
VITE_SUPPORT_WHATSAPP=2010XXXXXXXX

# ---------------------------------------------------------------------------
# Edge Function secrets - DO NOT put these in .env.local / Vercel.
# Set them on Supabase only:
#   supabase secrets set --env-file supabase/functions/.env
# (copy supabase/functions/.env.example to supabase/functions/.env first)
#
#   PAYMOB_SECRET_KEY, PAYMOB_PUBLIC_KEY, PAYMOB_HMAC_SECRET,
#   PAYMOB_INTEGRATION_IDS, META_APP_ID, META_APP_SECRET, APP_URL
#   (optional) PAYMOB_API_BASE, CRON_SECRET
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions
# automatically by Supabase.
# ---------------------------------------------------------------------------
