# Edge Function secrets. Copy to supabase/functions/.env (git-ignored) and run:
#   supabase secrets set --env-file supabase/functions/.env
# All values below are placeholders.

# Paymob dashboard -> Settings / Developers (Egypt account)
PAYMOB_SECRET_KEY=egy_sk_test_xxxxxxxxxxxxxxxx
PAYMOB_PUBLIC_KEY=egy_pk_test_xxxxxxxxxxxxxxxx
PAYMOB_HMAC_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated integration IDs to offer at checkout (card, wallet, Fawry...)
PAYMOB_INTEGRATION_IDS=1111111,2222222,3333333
# Optional: regional API host (default https://accept.paymob.com)
# PAYMOB_API_BASE=https://accept.paymob.com

# Meta app -> App settings -> Basic
META_APP_ID=000000000000000
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of the frontend, no trailing slash (used for redirects and CORS)
APP_URL=https://app.your-domain.com

# Optional: shared secret for the daily meta-sync cron call (x-cron-secret header)
# CRON_SECRET=long-random-string
